{
  "name": "@swadhin/pi-harness",
  "version": "0.6.58",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "lint": "node scripts/verify.mjs --lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:live": "tsx scripts/live.ts",
    "test:live:basic": "tsx scripts/live.ts --basic",
    "test:live:workshop": "tsx scripts/live-workshop.ts",
    "test:live:web": "tsx scripts/live-web.ts",
    "verify": "node scripts/verify.mjs",
    "doctor": "tsx src/cli.ts doctor",
    "install:local": "tsx scripts/install.ts",
    "test:live:recurring": "tsx scripts/live-recurring.ts",
    "test:live:delegation": "tsx scripts/live-delegation.ts",
    "test:live:branches": "tsx scripts/live-branches.ts",
    "test:live:host": "tsx scripts/live-host-routing.ts",
    "test:live:recovery": "tsx scripts/live-task-recovery.ts",
    "test:live:workers": "tsx scripts/live-workers.ts",
    "test:live:memory": "tsx scripts/live-project-memory.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
